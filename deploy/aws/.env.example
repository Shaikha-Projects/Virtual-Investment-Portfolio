# Copy to deploy/aws/.env (ignored), chmod 600, edit on EC2. No trailing origin slash.
PUBLIC_HOST=
PUBLIC_ORIGIN=
# Prefer the CI-verified versioned tag; set latest explicitly if desired.
IMAGE_TAG=build-11-e7c0e6fe6a10
DB_PASSWORD=
# Base64 encoding of >=32 random bytes; SAME value is passed to all three services.
JWT_SECRET=
INTERNAL_SERVICE_KEY=
# Gmail address and app password used by the existing SMTP implementation.
MAIL_USERNAME=
MAIL_PASSWORD=
# Existing Stripe SANDBOX secret and Gemini Developer API key.
STRIPE_SECRET_KEY=
GEMINI_API_KEY=
# Optional bootstrap of a new active administrator. Existing accounts are untouched.
ADMIN_EMAIL=
ADMIN_PASSWORD=
